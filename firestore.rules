rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{id} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == id;
      allow update: if signedIn() && (request.auth.uid == id || isAdmin());
    }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /events/{id} { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /donations/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /gallery/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
